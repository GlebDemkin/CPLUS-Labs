MENU main "Главное меню"
{
    ITEM start "Начать"
    {
        SIZE 400 58
        ACTION start_game
        COLOR 60 110 220 255
        SELECTED_COLOR 90 150 255 255
        TEXT_COLOR 255 255 255 255
    }

    SUBMENU settings "Настройки"
    {
        SIZE 400 58
        COLOR 70 70 70 255
        SELECTED_COLOR 110 110 110 255
        TEXT_COLOR 255 255 255 255

        ITEM graphics "Графика"
        {
            SIZE 360 54
            ACTION open_graphics_dialog
            COLOR 70 70 70 255
            SELECTED_COLOR 110 110 110 255
            TEXT_COLOR 255 255 255 255
        }

        ITEM sound "Звук"
        {
            SIZE 360 54
            ACTION open_sound_dialog
            COLOR 70 70 70 255
            SELECTED_COLOR 110 110 110 255
            TEXT_COLOR 255 255 255 255
        }

        ITEM back "Назад"
        {
            SIZE 360 54
            ACTION go_back
            COLOR 50 50 50 255
            SELECTED_COLOR 90 90 90 255
            TEXT_COLOR 255 255 255 255
        }
    }

    ITEM about "О программе"
    {
        SIZE 400 58
        ACTION open_about_dialog
        COLOR 70 70 70 255
        SELECTED_COLOR 110 110 110 255
        TEXT_COLOR 255 255 255 255
    }

    ITEM close "Закрыть меню"
    {
        SIZE 400 58
        ACTION close_menu
        COLOR 80 80 90 255
        SELECTED_COLOR 120 120 140 255
        TEXT_COLOR 255 255 255 255
    }

    ITEM exit "Выход из программы"
    {
        SIZE 400 58
        ACTION exit_application
        COLOR 150 50 50 255
        SELECTED_COLOR 210 70 70 255
        TEXT_COLOR 255 255 255 255
    }
}

DIALOG start_dialog "Начать"
{
    SIZE 620 310
    TEXT "Здесь может запускаться основная часть программы. Пока это демонстрационное действие."

    BUTTON ok "ОК"
    {
        SIZE 180 48
        ACTION close_dialog
    }
}

DIALOG about_dialog "О программе"
{
    SIZE 700 330
    TEXT "Лабораторная работа: система меню. Меню описывается во внешнем файле ресурсов формата .gleb и отрисовывается через NanoVG."

    BUTTON ok "ОК"
    {
        SIZE 180 48
        ACTION close_dialog
    }
}

DIALOG graphics_dialog "Графика"
{
    SIZE 620 310
    TEXT "Здесь могут находиться настройки графики. Это диалоговое окно загружено из файла ресурсов."

    BUTTON ok "ОК"
    {
        SIZE 180 48
        ACTION close_dialog
    }
}

DIALOG sound_dialog "Звук"
{
    SIZE 620 310
    TEXT "Здесь могут находиться настройки звука. Это диалоговое окно также описано во внешнем файле."

    BUTTON ok "ОК"
    {
        SIZE 180 48
        ACTION close_dialog
    }
}
